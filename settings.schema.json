{
  "$schema": "https://json-schema.org",
  "type": "object",
  "properties": {
    "antID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "teeth": {
      "type": "object",
      "properties": {
        "front": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1,
          "maxItems": 3
        },
        "rear": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1,
          "maxItems": 15
        }
      }
    }
  },
  "required": [
    "antID"
  ]
}
